# FALSE or TRUE
AI_ENABLED=FALSE 

# MC API. You don't need to fill this out
# MC_API_URL=
# MC_API_KEY=

# ER:LC API. You don't need to fill this out (DO NOT USE YOUR ER:LC API KEY IN THE PRC_API_KEY FIELD)
