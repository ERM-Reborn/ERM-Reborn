ENVIRONMENT= # PRODUCTION or DEVELOPMENT
SENTRY_URL= # Your sentry API URL, found in the sentry dashboard
SENTRY_BASE_URL= # Your sentry base URL for redirecting to the error
PRODUCTION_BOT_TOKEN= # Your production bot token
DEVELOPMENT_BOT_TOKEN= # Your development bot token
BLOXLINK_API_KEY= # Your BloxLink API key

# For the dashboard authentication
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=

# DO NOT CHANGE
